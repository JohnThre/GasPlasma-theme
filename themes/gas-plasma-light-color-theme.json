{
  "$schema": "vscode://schemas/color-theme",
  "name": "Gas Plasma Light",
  "type": "light",
  "semanticHighlighting": true,
  "colors": {
    "activityBar.background": "#F6E0C4",
    "activityBar.foreground": "#5C2400",
    "activityBarBadge.background": "#C42B00",
    "activityBarBadge.foreground": "#FFF5EA",
    "badge.background": "#C42B00",
    "badge.foreground": "#FFF5EA",
    "button.background": "#C42B00",
    "button.foreground": "#FFF5EA",
    "button.hoverBackground": "#D8400A",
    "dropdown.background": "#F6E0C4",
    "dropdown.border": "#E3BE94",
    "editor.background": "#FFF5EA",
    "editor.foreground": "#B84A00",
    "editor.lineHighlightBackground": "#F9E2C6",
    "editor.selectionBackground": "#FF8C0038",
    "editorCursor.foreground": "#E06A00",
    "editorIndentGuide.background1": "#E3BE94",
    "editorIndentGuide.activeBackground1": "#D98A2B",
    "editorLineNumber.foreground": "#A86A3A",
    "editorLineNumber.activeForeground": "#B06A00",
    "editorWhitespace.foreground": "#E3BE94",
    "input.background": "#F6E0C4",
    "input.border": "#E3BE94",
    "input.foreground": "#5C2400",
    "list.activeSelectionBackground": "#E3BE94",
    "list.activeSelectionForeground": "#3D1A00",
    "list.hoverBackground": "#F1D5B2",
    "panel.background": "#FBEDDC",
    "panel.border": "#E3BE94",
    "sideBar.background": "#FBEDDC",
    "sideBar.foreground": "#B84A00",
    "sideBarSectionHeader.background": "#F6E0C4",
    "statusBar.background": "#F9E2C6",
    "statusBar.foreground": "#3D1A00",
    "tab.activeBackground": "#FFF5EA",
    "tab.activeForeground": "#3D1A00",
    "tab.inactiveBackground": "#F6E0C4",
    "tab.inactiveForeground": "#7A4A22",
    "terminal.ansiBlack": "#3D1A00",
    "terminal.ansiRed": "#C42B00",
    "terminal.ansiGreen": "#5B6B00",
    "terminal.ansiYellow": "#9C5A00",
    "terminal.ansiBlue": "#A04E00",
    "terminal.ansiMagenta": "#B5304A",
    "terminal.ansiCyan": "#8A6200",
    "terminal.ansiWhite": "#B89A80",
    "terminal.ansiBrightBlack": "#7A4A22",
    "terminal.ansiBrightRed": "#D8400A",
    "terminal.ansiBrightGreen": "#6E8000",
    "terminal.ansiBrightYellow": "#B06A00",
    "terminal.ansiBrightBlue": "#B85C00",
    "terminal.ansiBrightMagenta": "#C94A60",
    "terminal.ansiBrightCyan": "#A07800",
    "terminal.ansiBrightWhite": "#E8D2BC",
    "titleBar.activeBackground": "#F6E0C4",
    "titleBar.activeForeground": "#3D1A00",
    "gitDecoration.addedResourceForeground": "#7A8C00",
    "gitDecoration.untrackedResourceForeground": "#7A8C00",
    "gitDecoration.modifiedResourceForeground": "#B06A00",
    "gitDecoration.stageModifiedResourceForeground": "#B06A00",
    "gitDecoration.deletedResourceForeground": "#9E2000",
    "gitDecoration.stageDeletedResourceForeground": "#9E2000",
    "gitDecoration.renamedResourceForeground": "#A07800",
    "gitDecoration.conflictingResourceForeground": "#B5304A",
    "gitDecoration.ignoredResourceForeground": "#A86A3A",
    "editorGutter.addedBackground": "#7A8C00",
    "editorGutter.modifiedBackground": "#B06A00",
    "editorGutter.deletedBackground": "#9E2000",
    "minimapGutter.addedBackground": "#7A8C00",
    "minimapGutter.modifiedBackground": "#B06A00",
    "minimapGutter.deletedBackground": "#9E2000",
    "editorOverviewRuler.addedForeground": "#7A8C0099",
    "editorOverviewRuler.modifiedForeground": "#B06A0099",
    "editorOverviewRuler.deletedForeground": "#9E200099",
    "editorOverviewRuler.errorForeground": "#9E2000",
    "editorOverviewRuler.warningForeground": "#B06A00",
    "editorOverviewRuler.infoForeground": "#8A6200",
    "diffEditor.insertedTextBackground": "#7A8C0038",
    "diffEditor.removedTextBackground": "#9E200038",
    "diffEditor.insertedLineBackground": "#7A8C001F",
    "diffEditor.removedLineBackground": "#9E20001F",
    "diffEditorGutter.insertedLineBackground": "#7A8C004D",
    "diffEditorGutter.removedLineBackground": "#9E20004D",
    "merge.currentHeaderBackground": "#7A8C0066",
    "merge.currentContentBackground": "#7A8C0029",
    "merge.incomingHeaderBackground": "#B5304A66",
    "merge.incomingContentBackground": "#B5304A29",
    "editorError.foreground": "#9E2000",
    "editorWarning.foreground": "#B06A00",
    "editorInfo.foreground": "#8A6200",
    "editorHint.foreground": "#A07800",
    "problemsErrorIcon.foreground": "#9E2000",
    "problemsWarningIcon.foreground": "#B06A00",
    "problemsInfoIcon.foreground": "#8A6200",
    "list.errorForeground": "#9E2000",
    "list.warningForeground": "#B06A00",
    "testing.iconPassed": "#7A8C00",
    "testing.iconFailed": "#9E2000",
    "testing.iconErrored": "#9E2000",
    "testing.iconQueued": "#B06A00",
    "notificationsErrorIcon.foreground": "#9E2000",
    "notificationsWarningIcon.foreground": "#B06A00",
    "notificationsInfoIcon.foreground": "#8A6200",
    "terminalCommandDecoration.successBackground": "#7A8C00",
    "terminalCommandDecoration.errorBackground": "#9E2000"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8C6A1A",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "constant.other.symbol"
      ],
      "settings": {
        "foreground": "#5B6B00"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language"
      ],
      "settings": {
        "foreground": "#9A5800"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#C42B00",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#A04E00"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#8A6200"
      }
    },
    {
      "scope": [
        "variable",
        "meta.definition.variable.name"
      ],
      "settings": {
        "foreground": "#5C2400"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "support.constant"
      ],
      "settings": {
        "foreground": "#B33A00"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#FFF5EA",
        "background": "#C42B00"
      }
    }
  ],
  "semanticTokenColors": {
    "class": "#8A6200",
    "enum": "#8A6200",
    "function": "#A04E00",
    "interface": "#8A6200",
    "keyword": "#C42B00",
    "method": "#A04E00",
    "namespace": "#9C5A00",
    "parameter": "#5C2400",
    "property": "#7A3D10",
    "string": "#5B6B00",
    "variable": "#5C2400"
  }
}
